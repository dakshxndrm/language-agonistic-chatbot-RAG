# Copy to .env and fill in. .env is gitignored (C4).

BHASHA_PROFILE=hybrid            # cloud | hybrid | onprem

# Provider selection. Ignored (forced local) when BHASHA_PROFILE=onprem.
ASR_EN_PROVIDER=groq             # groq | local
ASR_INDIC_PROVIDER=sarvam        # sarvam | local
LLM_PROVIDER=groq                # groq | ollama | vllm
LLM_MODEL=openai/gpt-oss-120b
TTS_PROVIDER=sarvam              # sarvam | kokoro
EMBED_PROVIDER=cohere            # cohere (default, cloud, free tier) | local (bge-m3, CPU-slow)
RERANK_PROVIDER=cohere           # cohere (default, cloud, free tier) | local (bge-reranker, CPU-slow)
EMBED_DEVICE=cpu                 # cpu | cuda — only used by the local bge-m3/bge-reranker fallback

# Must be empty when BHASHA_PROFILE=onprem — startup fails loudly otherwise.
GROQ_API_KEY=
SARVAM_API_KEY=
COHERE_API_KEY=
DATABASE_URL=postgresql+asyncpg://bhasha:bhasha@localhost:5432/bhasha
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_at_least_32_chars

VAD_SILENCE_MS=600
RETRIEVE_TOP_K=20
RERANK_TOP_K=5
FIDELITY_SCRIPT_THRESHOLD=0.15   # foreign-script ratio that triggers repair

# Postgres container credentials (docker-compose only)
POSTGRES_USER=bhasha
POSTGRES_PASSWORD=bhasha
POSTGRES_DB=bhasha

# Graph is additive (C11) — bring it up with `docker compose --profile hybrid up neo4j`.
# onprem forces neo4j_local unconditionally, never neo4j_aura.
GRAPH_PROVIDER=none               # neo4j_local | neo4j_aura | none
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAPH_MAX_HOPS=2
GRAPH_TRIGGER_TYPES=multi_hop,comparative